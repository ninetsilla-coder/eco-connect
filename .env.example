# ==============================================================
# Plantilla de variables de entorno
# ==============================================================
# Este archivo SÍ se sube al repo: documenta qué variables hacen falta,
# sin valores reales. Para trabajar en local, cópialo:
#
#   copy .env.example .env.local        (Windows)
#   cp   .env.example .env.local        (macOS / Linux)
#
# y rellena los valores. .env.local está ignorado por git.
#
# Las lee solo api/contacto.js, en el servidor. No llegan al navegador.
# En producción se configuran en Vercel → Settings → Environment Variables.
# ==============================================================

# Llave secreta de Resend. Empieza por "re_".
RESEND_API_KEY=

# Correo que recibe los avisos del formulario de contacto.
CORREO_DESTINO=
