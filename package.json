{
  "name": "eco-connect",
  "version": "1.0.0",
  "private": true,
  "description": "Marketplace B2B de economia circular. Sitio estatico + Supabase + una funcion serverless.",
  "type": "module",
  "scripts": {
    "test": "node --import ./tests/ayudas/registrar.js --test \"tests/**/*.test.js\"",
    "test:watch": "node --import ./tests/ayudas/registrar.js --test --watch tests/",
    "test:cobertura": "node --import ./tests/ayudas/registrar.js --test --experimental-test-coverage tests/",
    "servir": "node --run servir:estatico",
    "servir:estatico": "npx --yes serve public"
  },
  "devDependencies": {
    "jsdom": "^26.1.0"
  }
}
